{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["node", "@sanity/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", "sanity.config.ts", "sanity.cli.ts"],
  "exclude": ["node_modules", "dist", ".sanity"]
}
